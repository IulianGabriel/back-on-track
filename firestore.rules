rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only you (signed in with your Google account) can read or write your own data.
    // Nobody else can sign in and store anything in this project.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email == 'burciuiuliangabriel18@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
